---
// How one command reaches every project. Every figure here is in README "Numbers" or ops.sh itself.
const steps = [
  { title: 'Every project', code: 'bindings.sh', note: 'about 35 lines each: only what differs' },
  { title: 'One script', code: 'ops.sh', note: '969 lines, byte-identical in every repo' },
  { title: 'Same verbs', code: 'up · health · doctor · backup-db', note: 'the same command in any project' },
  { title: 'Exit codes', code: '0 ok · 3 n/a · 5 unhealthy', note: 'a person or an AI agent acts on the result' },
];
---

<ol class="flow">
  {
    steps.map((s, i) => (
      <li>
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <strong>{s.title}</strong>
        <code>{s.code}</code>
        <span class="note">{s.note}</span>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.15rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
  }

  /* Arrow into the next step. */
  li + li::before {
    content: '→';
    position: absolute;
    left: -1.2rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--accent);
    font: 600 0.95rem/1 var(--mono);
  }

  .n {
    font: 500 0.72rem/1 var(--mono);
    color: var(--accent);
  }

  strong {
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  code {
    font: 0.78rem/1.45 var(--mono);
    color: var(--ink);
  }

  .note {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
    }

    li + li::before {
      content: '↓';
      left: 1.15rem;
      top: -1.15rem;
      translate: 0 0;
    }
  }
</style>
