---
import { Image } from 'astro:assets';
import { hostOf, screenshotFor, type Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const host = hostOf(project.url);
const shot = screenshotFor(project.slug);
const featured = Boolean(project.featured);
---

<article class:list={['card', { featured, 'has-shot': shot }]}>
  {
    shot && (
      <div class="shot">
        <div class="chrome" aria-hidden="true">
          <i />
          <i />
          <i />
          <span>{host}</span>
        </div>
        <Image
          src={shot}
          alt={`${project.name} homepage`}
          widths={featured ? [640, 960, 1280] : [400, 640, 960]}
          sizes={featured ? '(min-width: 900px) 600px, 100vw' : '(min-width: 1000px) 330px, (min-width: 640px) 50vw, 100vw'}
          loading={featured ? 'eager' : 'lazy'}
        />
      </div>
    )
  }
  <div class="body">
    <div class="top">
      <h3>
        <!-- The name is the link; its ::after stretches over the whole card. -->
        <a class="stretch" href={project.url}>{project.name}</a>
      </h3>
      <span class:list={['status', project.status]}>
        <span class="dot" aria-hidden="true"></span>{project.status}
      </span>
    </div>
    <p class="host">{host} <span aria-hidden="true">↗</span></p>
    <p class="pitch">{project.pitch}</p>
    {
      project.metric && (
        <p class="metric">
          <strong>{project.metric.value}</strong> {project.metric.label}
        </p>
      )
    }
    <ul class="built">
      {project.built.map((item) => <li>{item}</li>)}
    </ul>
    <ul class="stack" aria-label="Stack">
      {project.stack.map((tech) => <li>{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--rule));
    transform: translateY(-2px);
    box-shadow: 0 12px 32px -12px var(--shadow-color);
  }

  /* Keyboard focus lands on the name link; outline the whole card instead. */
  .card:has(.stretch:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .stretch {
    text-decoration: none;
  }

  .stretch:focus-visible {
    outline: none;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .shot {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .chrome i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--rule);
  }

  .chrome span {
    flex: 1;
    margin-left: 0.5rem;
    margin-right: 1.4rem;
    padding: 0.1rem 0.5rem;
    border-radius: 5px;
    background: var(--surface);
    font: 0.68rem/1.5 var(--mono);
    color: var(--muted);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shot img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
  }

  .card:hover .shot img {
    transform: scale(1.015);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.35rem 1.5rem 1.5rem;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .status {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    font: 500 0.7rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .status.beta {
    color: var(--beta);
    background: var(--beta-soft);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .host {
    margin: 0.3rem 0 0;
    font: 0.82rem var(--mono);
    color: var(--muted);
  }

  .card:hover .host {
    color: var(--accent);
  }

  .pitch {
    margin: 0.9rem 0 0.75rem;
  }

  .metric {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .metric strong {
    font: 600 1.15rem var(--mono);
    color: var(--accent);
  }

  .built {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .built li + li {
    margin-top: 0.3rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    font: 0.72rem/1.4 var(--mono);
    color: var(--muted);
  }

  /* Featured: screenshot beside the text on wide screens. */
  @media (min-width: 900px) {
    .featured.has-shot {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    .featured .shot {
      display: flex;
      flex-direction: column;
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }

    /* Fill the full card height; the text column is taller than 16:10. */
    .featured .shot img {
      flex: 1;
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }

    .featured .body {
      padding: 2rem 2.25rem;
    }

    .featured h3 {
      font-size: 1.6rem;
      letter-spacing: -0.02em;
    }

    .featured .pitch {
      font-size: 1.1rem;
    }
  }
</style>
