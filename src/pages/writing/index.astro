---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../data/posts';
import { href } from '../../lib/url';

const posts = await getPosts();
---

<Base title="Writing" description="Notes on running infrastructure, shipping products, and building with AI.">
  <section class="wrap page">
    <p class="eyebrow">Writing</p>
    <h1>Notes from running the fleet</h1>
    <p class="lede">Infrastructure, shipping products solo, and putting AI agents to work on real systems.</p>

    {
      posts.length === 0 && (
        <p class="empty">
          First posts are on the way. Until then, <a href={href('/#work')}>see what I've shipped →</a>
        </p>
      )
    }

    <ul>
      {
        posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <a href={href(`/writing/${post.id}/`)}>{post.data.title}</a>
              {post.data.draft && <span class="tag">draft</span>}
              <p>{post.data.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .page {
    max-width: 820px;
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  h1 {
    margin: 0.75rem 0 0.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .lede {
    color: var(--muted);
  }

  .empty {
    margin-top: 2.5rem;
    padding: 1.25rem 1.4rem;
    border: 1px dashed var(--rule);
    border-radius: 12px;
    color: var(--muted);
  }

  .empty a {
    font-size: inherit;
    font-weight: 500;
    color: var(--ink);
  }

  ul {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  time {
    padding-top: 0.2rem;
    font: 0.8rem var(--mono);
    color: var(--muted);
  }

  a {
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  li p {
    margin: 0.3rem 0 0;
    color: var(--muted);
  }

  li .tag {
    margin-left: 0.5rem;
  }
</style>
